# Эту строчку лучше убрать когда все будет готово, сейчас она только в помощь тестов
kill @e[type=armor_stand,tag=runtime]

#==========================================================================================================================================================================================================================================================#
    # Стойка ограничитель №1
    execute unless entity @e[type=armor_stand,tag=limiter_1,limit=1] run summon armor_stand 0 10 11 {Tags:["runtime","limiter_1"],NoGravity:true}
    
    # Стойка ограничитель №2
    execute unless entity @e[type=armor_stand,tag=limiter_2,limit=1] run summon armor_stand -11 10 0 {Tags:["runtime","limiter_2"],NoGravity:true}
    
    # Стойка ограничитель №3
    execute unless entity @e[type=armor_stand,tag=limiter_3,limit=1] run summon armor_stand 0 10 -11 {Tags:["runtime","limiter_3"],NoGravity:true}
    
    # Стойка ограничитель №4
    execute unless entity @e[type=armor_stand,tag=limiter_4,limit=1] run summon armor_stand 11 10 0 {Tags:["runtime","limiter_4"],NoGravity:true}
